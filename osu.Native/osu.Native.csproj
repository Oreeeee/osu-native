<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework Condition="'$(RuntimeIdentifier)' == 'win-x86'">net9.0-windows</TargetFramework>
        <TargetFramework Condition="'$(RuntimeIdentifier)' != 'win-x86'">net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>

        <SupportedOSPlatformVersion Condition="'$(RuntimeIdentifier)' == 'win-x86'">5.1</SupportedOSPlatformVersion>

        <!-- NativeAOT configuration -->
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>

        <!-- Removes the libicu runtime dependency of the native library -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Excludes the localized resource satellite assemblies (Humanizer.Core.*, osu.Game.Resources)
             from the AOT publish. In globalization-invariant mode, RulesetStore fails when enumerating
             assemblies with a non-invariant culture. "xx" does not match any real language, so no
             satellite assemblies are included -->
        <SatelliteResourceLanguages>xx</SatelliteResourceLanguages>

        <!-- Generate information for sizoscope -->
        <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
        <IlcGenerateDgmlFile>true</IlcGenerateDgmlFile>

        <!-- Generates the cabinet.h C-header file on publish -->
        <GenerateCabinet>true</GenerateCabinet>
    </PropertyGroup>

    <!-- Embedding the file as an EmbeddedResource only allows targetting the current assembly,
       therefore we need to use the substitution Ilc argument, targetting the whole compilation. -->
    <ItemGroup>
        <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)ILLink.Substitutions.xml" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\osu.Native.Analyzers\osu.Native.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\osu\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
        <ProjectReference Include="..\..\osu\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
        <ProjectReference Include="..\..\osu\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
        <ProjectReference Include="..\..\osu\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
        <ProjectReference Include="..\..\osu\osu.Game\osu.Game.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="cabi.net" Version="0.0.7" />
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
        <PackageReference Include="YY-Thunks" Version="1.2.2" />
    </ItemGroup>
</Project>